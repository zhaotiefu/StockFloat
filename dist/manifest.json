{
  "manifest_version": 3,
  "name": "Stock Float",
  "version": "1.1.0",
  "description": "轻量级 A 股行情悬浮窗 — 独立白色悬浮窗，任意页面可用。",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Stock Float",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "windows"
  ],
  "host_permissions": [
    "https://qt.gtimg.cn/*",
    "http://qt.gtimg.cn/*"
  ]
}